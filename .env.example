# ============================================================
# CrisisSwarm — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env — only commit .env.example
# ============================================================

# --- Groq API (required for AI agents) ---
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Groq backup key (optional but recommended) ---
# Use a key from a DIFFERENT Groq account for true rate limit fallback
# If both keys are on the same account they share the same daily quota
GROQ_API_KEY_2=your_second_groq_api_key_here

# --- Groq model (optional) ---
# Default: llama-3.3-70b-versatile
# Use llama-3.1-8b-instant for faster/cheaper runs
GROQ_MODEL=llama-3.3-70b-versatile

# --- Azure Maps (optional) ---
# Get key at https://portal.azure.com → Azure Maps account
# If not set, routing uses haversine distance calculation
AZURE_MAPS_KEY=your_azure_maps_subscription_key_here

# --- Streamlit (optional) ---
STREAMLIT_PORT=8501
SERVICE_NAME=CrisisSwarm
