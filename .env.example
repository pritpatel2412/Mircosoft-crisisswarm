# Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
# Second Groq key — used as fallback if first hits rate limit
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Max tokens per agent JSON call (lower = less daily quota use)
GROQ_MAX_TOKENS=1024
AZURE_MAPS_KEY="your-azure-maps-key"
AZURE_CLIENT_ID="your-client-id"
AZURE_CLIENT_SECRET="your-client-secret"
AZURE_TENANT_ID="your-tenant-id"
STREAMLIT_PORT="8501"
SERVICE_NAME="CrisisSwarm"
